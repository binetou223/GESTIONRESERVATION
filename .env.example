APP_ENV=development
APP_DEBUG=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservation_salles
DB_USERNAME=root
DB_PASSWORD=

# SSL (requis pour les fournisseurs comme Aiven). Mettre à "false" en local avec Docker Compose.
DB_SSL_ENABLED=true
# Optionnel : chemin personnalisé vers le certificat CA (par défaut config/ssl/aiven-ca.pem)
# DB_SSL_CA=/var/www/html/config/ssl/aiven-ca.pem